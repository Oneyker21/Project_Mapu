{
  "expo": {
    "name": "Mapu",
    "slug": "mapu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/Images/Mapu_Icon.png",
    "splash": {
      "image": "./assets/Images/Mapu-Charging.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff",
      "hideExponentText": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Images/Mapu_Icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "splash": {
        "image": "./assets/Images/Mapu-Charging.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mapu.travelguide",
      "displayName": "Mapu",
       "permissions": [
         "ACCESS_FINE_LOCATION",
         "ACCESS_COARSE_LOCATION",
         "ACCESS_BACKGROUND_LOCATION",
         "ACCESS_LOCATION_EXTRA_COMMANDS",
         "ACCESS_NETWORK_STATE",
         "ACCESS_WIFI_STATE",
         "INTERNET",
         "android.permission.ACCESS_COARSE_LOCATION",
         "android.permission.ACCESS_FINE_LOCATION"
       ],
       "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "displayName": "Mapu",
      "splash": {
        "image": "./assets/Images/Mapu-Charging.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrarte centros turísticos cercanos y crear rutas personalizadas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrarte centros turísticos cercanos y crear rutas personalizadas."
      }
    },
    "web": {
      "favicon": "./assets/Images/Mapu_Icon.png"
    },
     "plugins": [
       [
         "expo-location",
         {
           "locationAlwaysAndWhenInUsePermission": "Permitir $(PRODUCT_NAME) usar tu ubicación para mostrar centros turísticos cercanos y crear rutas personalizadas.",
           "locationWhenInUsePermission": "Permitir $(PRODUCT_NAME) usar tu ubicación para mostrar centros turísticos cercanos y crear rutas personalizadas."
         }
       ]
     ],
    "extra": {
      "eas": {
        "projectId": "4454115f-02cd-4b68-ae0f-0f7ab62abc16"
      }
    },
    "owner": "oneygaleano"
  }
}
